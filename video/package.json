{
  "name": "zashu-demo-video",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "render:16x9": "remotion render ZashuDemo16x9 out/zashu-demo-16x9.mp4 && ./scripts/master.sh out/zashu-demo-16x9.mp4",
    "render:9x16": "remotion render ZashuDemo9x16 out/zashu-demo-9x16.mp4 && ./scripts/master.sh out/zashu-demo-9x16.mp4",
    "sfx": "./scripts/make-sfx.sh && python3 -I scripts/make-music.py",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.250",
    "@remotion/google-fonts": "4.0.547",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.250"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
